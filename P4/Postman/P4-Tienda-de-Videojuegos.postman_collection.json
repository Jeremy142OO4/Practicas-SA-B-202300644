{
  "info": {
    "_postman_id": "d7abf43e-6fca-4a34-a311-202300644004",
    "name": "P4 - Tienda de Videojuegos",
    "description": "Contratos de P4 adaptados al despliegue de P5. Todas las solicitudes externas pasan por el API Gateway y el pago normal se procesa de forma asincrona mediante RabbitMQ.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000" },
    { "key": "correo", "value": "jeremy.postman@example.com" },
    { "key": "password", "value": "123456" },
    { "key": "token", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "categoryId", "value": "" },
    { "key": "platformId", "value": "" },
    { "key": "gameId", "value": "" },
    { "key": "productId", "value": "" },
    { "key": "cartId", "value": "" },
    { "key": "orderId", "value": "" },
    { "key": "paymentId", "value": "" },
    { "key": "paymentPollAttempt", "value": "0" },
    { "key": "enableLegacyDirectPayment", "value": "false" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Jeremy Postman\",\n  \"correo\": \"{{correo}}\",\n  \"password\": \"{{password}}\"\n}" },
            "url": "{{baseUrl}}/auth/register",
            "description": "Registra un usuario con rol CLIENTE. Respuestas: 201, 400 o 409."
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Registro aceptado', () => pm.expect([201, 409]).to.include(pm.response.code));", "if (pm.response.code === 201) pm.collectionVariables.set('userId', pm.response.json().usuario.id_usuario);"] } }]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"correo\": \"{{correo}}\",\n  \"password\": \"{{password}}\"\n}" },
            "url": "{{baseUrl}}/auth/login",
            "description": "Autentica al usuario y devuelve un JWT."
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Login correcto', () => pm.response.to.have.status(200));", "const json = pm.response.json();", "pm.collectionVariables.set('token', json.token);", "pm.collectionVariables.set('userId', json.usuario.id_usuario);"] } }]
        },
        {
          "name": "Validate Token",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }],
            "url": "{{baseUrl}}/auth/validate",
            "description": "Valida el JWT y devuelve el usuario y rol contenidos en el token."
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Token válido', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().valido).to.eql(true); });"] } }]
        }
      ]
    },
    {
      "name": "Catalog",
      "item": [
        {
          "name": "Crear categoría",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"query\": \"mutation { crearCategoria(nombre: \\\"Accion {{$timestamp}}\\\", descripcion: \\\"Juegos de accion\\\") { idCategoria nombre descripcion } }\"\n}" },
            "url": "{{baseUrl}}/catalog/graphql"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Categoría creada', () => pm.response.to.have.status(200));", "pm.collectionVariables.set('categoryId', pm.response.json().data.crearCategoria.idCategoria);"] } }]
        },
        {
          "name": "Crear plataforma",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"query\": \"mutation { crearPlataforma(nombre: \\\"PC {{$timestamp}}\\\", descripcion: \\\"Computadora\\\") { idPlataforma nombre descripcion } }\"\n}" },
            "url": "{{baseUrl}}/catalog/graphql"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Plataforma creada', () => pm.response.to.have.status(200));", "pm.collectionVariables.set('platformId', pm.response.json().data.crearPlataforma.idPlataforma);"] } }]
        },
        {
          "name": "Crear videojuego",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"query\": \"mutation { crearVideojuego(titulo: \\\"Minecraft {{$timestamp}}\\\", descripcion: \\\"Juego de construccion\\\", idCategoria: {{categoryId}}, desarrollador: \\\"Mojang\\\", fechaLanzamiento: \\\"2011-11-18\\\") { idVideojuego titulo desarrollador estado } }\"\n}" },
            "url": "{{baseUrl}}/catalog/graphql"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Videojuego creado', () => pm.response.to.have.status(200));", "pm.collectionVariables.set('gameId', pm.response.json().data.crearVideojuego.idVideojuego);"] } }]
        },
        {
          "name": "Asignar plataforma",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"query\": \"mutation { asignarPlataforma(idVideojuego: \\\"{{gameId}}\\\", idPlataforma: {{platformId}}, precio: 250.00, stock: 20) { idVideojuegoPlataforma precio stock activo plataforma { nombre } } }\"\n}" },
            "url": "{{baseUrl}}/catalog/graphql"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Plataforma asignada', () => pm.response.to.have.status(200));", "pm.collectionVariables.set('productId', pm.response.json().data.asignarPlataforma.idVideojuegoPlataforma);"] } }]
        },
        {
          "name": "Listar videojuegos",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"query\": \"{ videojuegos { idVideojuego titulo desarrollador categoria { nombre } plataformas { idVideojuegoPlataforma precio stock plataforma { nombre } } } }\"\n}" },
            "url": "{{baseUrl}}/catalog/graphql"
          }
        },
        {
          "name": "Consultar stock",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"query\": \"{ stock(id: \\\"{{productId}}\\\") }\"\n}" },
            "url": "{{baseUrl}}/catalog/graphql"
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Obtener carrito",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"query\": \"query { carrito(idUsuario: \\\"{{userId}}\\\") { idCarrito idUsuario estado detalles { idDetalleCarrito idVideojuegoPlataforma cantidad precioUnitario } } }\"\n}" },
            "url": "{{baseUrl}}/orders/graphql"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Carrito obtenido', () => pm.response.to.have.status(200));", "pm.collectionVariables.set('cartId', pm.response.json().data.carrito.idCarrito);"] } }]
        },
        {
          "name": "Agregar producto",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"query\": \"mutation { agregarProducto(idUsuario: \\\"{{userId}}\\\", idVideojuegoPlataforma: \\\"{{productId}}\\\", cantidad: 1) { idCarrito estado detalles { idDetalleCarrito idVideojuegoPlataforma cantidad precioUnitario } } }\"\n}" },
            "url": "{{baseUrl}}/orders/graphql"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Producto agregado', () => pm.response.to.have.status(200));", "pm.collectionVariables.set('cartId', pm.response.json().data.agregarProducto.idCarrito);"] } }]
        },
        {
          "name": "Crear orden",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"query\": \"mutation { crearOrden(idCarrito: \\\"{{cartId}}\\\") { idOrden total estado detalles { nombreVideojuego plataforma cantidad precioUnitario subtotal } } }\"\n}" },
            "url": "{{baseUrl}}/orders/graphql"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Orden creada', () => pm.response.to.have.status(200));", "pm.collectionVariables.set('orderId', pm.response.json().data.crearOrden.idOrden);"] } }]
        },
        {
          "name": "Listar órdenes",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"query\": \"{ ordenes(idUsuario: \\\"{{userId}}\\\") { idOrden total estado detalles { nombreVideojuego plataforma cantidad subtotal } } }\"\n}" },
            "url": "{{baseUrl}}/orders/graphql"
          }
        },
        {
          "name": "Pagar orden",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"query\": \"mutation { pagarOrden(idOrden: \\\"{{orderId}}\\\", idMetodoPago: 1) { idOrden total estado } }\"\n}" },
            "url": "{{baseUrl}}/orders/graphql"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Pago publicado para procesamiento asincrono', () => {", "  pm.response.to.have.status(200);", "  const estado = pm.response.json().data.pagarOrden.estado;", "  pm.expect(['PAGO_EN_PROCESO', 'PAGADA']).to.include(estado);", "});", "pm.collectionVariables.set('paymentPollAttempt', '0');"] } }]
        },
        {
          "name": "Consultar estado de orden (hasta PAGADA)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"query\": \"{ orden(idOrden: \\\"{{orderId}}\\\") { idOrden total estado } }\"\n}" },
            "url": "{{baseUrl}}/orders/graphql",
            "description": "Comprueba la consistencia eventual del pago. En Collection Runner se repite hasta 10 veces mientras el estado sea PAGO_EN_PROCESO. Con Send manual, vuelva a enviarla si el pago aun esta en proceso."
          },
          "event": [
            { "listen": "prerequest", "script": { "exec": ["const intento = Number(pm.collectionVariables.get('paymentPollAttempt') || 0);", "if (intento > 0) {", "  setTimeout(() => {}, 1000);", "}"] } },
            { "listen": "test", "script": { "exec": ["pm.test('Consulta de orden correcta', () => pm.response.to.have.status(200));", "const respuesta = pm.response.json();", "pm.expect(respuesta.errors, JSON.stringify(respuesta.errors || [])).to.be.undefined;", "const estado = respuesta.data.orden.estado;", "pm.test('Estado asincrono valido', () => pm.expect(['PAGO_EN_PROCESO', 'PAGADA']).to.include(estado));", "let intento = Number(pm.collectionVariables.get('paymentPollAttempt') || 0);", "if (estado === 'PAGO_EN_PROCESO' && intento < 10) {", "  pm.collectionVariables.set('paymentPollAttempt', String(intento + 1));", "  pm.execution.setNextRequest(pm.info.requestName);", "} else {", "  pm.collectionVariables.set('paymentPollAttempt', '0');", "  pm.test('Pago procesado por RabbitMQ', () => pm.expect(estado).to.eql('PAGADA'));", "}"] } }
          ]
        }
      ]
    },
    {
      "name": "Payments",
      "item": [
        {
          "name": "Listar métodos de pago",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/payments/metodos" }
        },
        {
          "name": "LEGACY P4 - Procesar pago directo (omitido por defecto)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"id_orden\": \"{{orderId}}\",\n  \"id_metodo_pago\": 1,\n  \"monto\": 250.00\n}" },
            "url": "{{baseUrl}}/payments/procesar",
            "description": "Contrato sincronico conservado de P4. No se usa en el flujo normal de P5 porque Orders publica el pago en RabbitMQ. Defina enableLegacyDirectPayment=true solo para probarlo aisladamente con una orden que aun no tenga pago."
          },
          "event": [
            { "listen": "prerequest", "script": { "exec": ["if (pm.collectionVariables.get('enableLegacyDirectPayment') !== 'true') {", "  pm.execution.skipRequest();", "}"] } },
            { "listen": "test", "script": { "exec": ["pm.test('Pago procesado', () => pm.response.to.have.status(200));", "pm.collectionVariables.set('paymentId', pm.response.json().pago.id_pago);"] } }
          ]
        },
        {
          "name": "Consultar pagos por orden",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/payments/orden/{{orderId}}",
            "description": "Consulta el pago creado por el consumidor de RabbitMQ y guarda su identificador para la siguiente solicitud."
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Consulta de pagos correcta', () => pm.response.to.have.status(200));", "const pagos = pm.response.json();", "pm.test('Existe un pago para la orden', () => pm.expect(pagos.length).to.be.greaterThan(0));", "if (pagos.length > 0) pm.collectionVariables.set('paymentId', pagos[0].id_pago);"] } }]
        },
        {
          "name": "Consultar pago",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/payments/{{paymentId}}" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Consulta de pago correcta', () => pm.response.to.have.status(200));", "pm.expect(pm.response.json().id_pago).to.eql(pm.collectionVariables.get('paymentId'));"] } }]
        }
      ]
    }
  ]
}
