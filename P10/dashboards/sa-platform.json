    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "¿Cuantas solicitudes de negocio recibe cada servicio?",
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "id": 5,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by(service)(rate(http_server_requests_total{route!~\"/health|/metrics|/metrics/\"}[1m]))",
          "legendFormat": "{{service}}{{pod}}",
          "refId": "A"
        }
      ],
      "title": "Trafico - solicitudes por segundo",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "¿Los usuarios reciben errores HTTP? Los errores GraphQL HTTP 200 no se cuentan como 5xx.",
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "id": 6,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(rate(http_server_requests_total{service=\"api-gateway\",route!~\"/health|/metrics\",status=~\"5..\"}[1m])) or (sum(rate(http_server_requests_total{service=\"api-gateway\",route!~\"/health|/metrics\"}[1m])) * 0))",
          "legendFormat": "{{service}}{{pod}}",
          "refId": "A"
        }
      ],
      "title": "Errores HTTP 5xx",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "¿Que pod esta consumiendo CPU?",
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
