{
  "id": null,
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "¿Que proporcion de solicitudes de negocio no devolvio HTTP 5xx? Objetivo 99%.",
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "unit": "percentunit",
          "noValue": "Sin trafico / sin datos",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "nan",
                "result": {
                  "text": "Sin trafico / sin datos",
                  "color": "gray"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "slo:api_availability:ratio",
          "legendFormat": "{{service}}{{pod}}",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "title": "Disponibilidad - ultima hora",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "¿El 95% de las solicitudes termina antes de 500 ms?",
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "unit": "s",
          "noValue": "Sin trafico / sin datos",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "nan",
                "result": {
                  "text": "Sin trafico / sin datos",
                  "color": "gray"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95,sum by (le)(rate(http_server_request_duration_seconds_bucket{service=\"api-gateway\",route!~\"/health|/metrics\"}[1m])))",
          "legendFormat": "{{service}}{{pod}}",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "title": "Latencia p95",
      "type": "stat"
    },
