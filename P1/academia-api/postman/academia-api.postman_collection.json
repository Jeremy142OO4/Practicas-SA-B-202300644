      "name": "1. Crear solicitud",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Estado 201\", function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "",
              "const response = pm.response.json();",
              "if (response.success && response.data && response.data.id) {",
              "  pm.collectionVariables.set(\"solicitudId\", response.data.id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"titulo\": \"Compra de equipo\",\n  \"area_solicitante\": \"Tecnología\",\n  \"prioridad\": 3,\n  \"costo_estimado\": 1250.50\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/solicitudes/",
